---
import SectionHeader from './SectionHeader.astro';
import { getLang, useTranslations } from '../i18n/utils';
import { content } from '../i18n/content';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { experience } = content[lang];
---

<section class="section-wrapper" id="experience">
  <SectionHeader title={t('experience.title')} dir="l" />
  {
    experience.map((exp, index) => (
      <div class="experience-item reveal" style={`transition-delay: ${index * 0.1}s`}>
        <div class="experience-heading">
          <span class="experience-title">{exp.title}</span>
          <span>{exp.date}</span>
        </div>
        <div class="experience-heading">
          <span class="experience-position">{exp.role}</span>
          <span>{exp.location}</span>
        </div>
        <p class="experience-description">{exp.description}</p>
        <div class="experience-tech">
          {
            exp.tech.map((tech) => (
              <span class="chip">{tech}</span>
            ))
          }
        </div>
      </div>
    ))
  }
</section>
