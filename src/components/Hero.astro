---
import { Icon as Iconify } from 'astro-icon/components';
import { getLang, useTranslations } from '../i18n/utils';
import { content } from '../i18n/content';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { hero } = content[lang];
---

<section class="section-wrapper hero" id="hero">
  <div class="hero-grid">
    <div class="hero-copy-wrapper">
      <div class="reveal-line">
        <div class="reveal-line-inner" style="animation-delay: 0.1s">
          <h1 class="hero-title">{hero.title}<span>.</span></h1>
        </div>
        <div class="reveal-curtain" style="animation-delay: 0.35s"></div>
      </div>

      <div class="reveal-line">
        <div class="reveal-line-inner" style="animation-delay: 0.2s">
          <h2 class="hero-subtitle"><span>{hero.tagline}</span></h2>
        </div>
        <div class="reveal-curtain" style="animation-delay: 0.45s"></div>
      </div>

      <div class="reveal-line">
        <div class="reveal-line-inner" style="animation-delay: 0.3s">
          <p class="hero-about-copy">
            {hero.p1}
            <br class="hero-breakline" /> {hero.p2}
            <br class="hero-breakline" /> {hero.p3}
          </p>
        </div>
        <div class="reveal-curtain" style="animation-delay: 0.55s"></div>
      </div>

      <div class="reveal-line">
        <div class="reveal-line-inner" style="animation-delay: 0.4s">
          <a aria-label={t('hero.aria.contact')} href="#contact">
            <button class="hero-contact-btn">{t('hero.contact')}</button>
          </a>
        </div>
        <div class="reveal-curtain" style="animation-delay: 0.65s"></div>
      </div>
    </div>

    <div class="hero-portrait">
      <div class="hero-portrait-frame">
        <img src="/portrait/omar-diego.webp" alt="Portrait photo" width="450" height="562" loading="eager" />
      </div>
      <span class="hero-portrait-bracket bracket-tl" aria-hidden="true"></span>
      <span class="hero-portrait-bracket bracket-tr" aria-hidden="true"></span>
      <span class="hero-portrait-bracket bracket-bl" aria-hidden="true"></span>
      <span class="hero-portrait-bracket bracket-br" aria-hidden="true"></span>
    </div>
  </div>

  <a class="hero-scroll-cue" href="#about" aria-label={t('hero.aria.scrollDown')}>
    <span>{t('hero.scrollDown')}</span>
    <Iconify name="lucide:arrow-down" width="1.6rem" height="1.6rem" />
  </a>
</section>
