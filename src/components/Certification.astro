---
import SectionHeader from './SectionHeader.astro';
import { getLang, useTranslations } from '../i18n/utils';
import { content } from '../i18n/content';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { certifications } = content[lang];
---

<section class="section-wrapper" id="certification">
  <SectionHeader title={t('certification.title')} dir="l" />
  {
    certifications.map((cert, index) => (
      <div class="certification-item reveal" style={`transition-delay: ${index * 0.1}s`}>
        <div class="certification-heading">
          <span class="certification-title">{cert.title}</span>
          <span>{cert.date}</span>
        </div>
        <div class="certification-heading">
          <span class="certification-school">{cert.school}</span>
          {cert.link && (
            <a class="certification-certificate" href={cert.link} target="_blank" rel="nofollow" title={t('certification.aria.certificate')} aria-label={t('certification.aria.certificate')}>
              {t('certification.certificate')}
            </a>
          )}
        </div>
        <p class="certification-description">{cert.description}</p>
        <div class="certification-tech">
          {
            cert.tech.map((tech) => (
              <span class="chip">{tech}</span>
            ))
          }
        </div>
      </div>
    ))
  }
</section>
